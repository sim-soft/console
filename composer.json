{
  "name": "simsoft/console",
  "description": "A lightweight, Laravel-inspired wrapper for Symfony Console — build PHP CLI commands with less boilerplate.",
  "keywords": [
    "console",
    "cli",
    "command",
    "terminal",
    "symfony",
    "laravel",
    "artisan",
    "php",
    "closure-command",
    "command-line",
    "scheduler",
    "cron",
    "dependency-injection",
    "psr-11",
    "simsoft"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/sim-soft/console",
  "authors": [
    {
      "name": "Sim",
      "email": "vzangloo@7mayday.com",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/sim-soft/console/issues",
    "source": "https://github.com/sim-soft/console"
  },
  "require": {
    "php": "^8.2",
    "dragonmantank/cron-expression": "^3.4",
    "psr/container": "^2.0",
    "symfony/console": "^7.2 || ^8.0",
    "symfony/lock": "^7.2 || ^8.0"
  },
  "require-dev": {
    "phpmd/phpmd": "^2.15",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.5|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Simsoft\\Console\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Example\\": "example/",
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --memory-limit=512M",
    "phpmd": "phpmd src text phpmd.xml",
    "check": [
      "@phpstan",
      "@phpmd",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
