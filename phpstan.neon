parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - vendor
    ignoreErrors:
        # These traits are public API, mixed in by applications that consume this
        # package. Analysing src alone, PHPStan sees no `use` of them anywhere and
        # reports them as dead. Scoped to the Traits directory so a genuinely
        # unused trait elsewhere in src is still reported.
        -
            identifier: trait.unused
            path: src/Traits/*

        # getLazyCommand() reflects on the constructor and throws when a subclass
        # requires arguments, so the `new static()` below that guard cannot be
        # reached with an incompatible signature. PHPStan does not follow it.
        -
            identifier: new.static
            path: src/Command.php
